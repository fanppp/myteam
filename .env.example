# myteam environment configuration
# Copy to .env and adjust as needed

# Environment name (runtime | alpha | feature-<name> | default)
MYTEAM_ENV=default

# API server port
MYTEAM_API_PORT=3001

# Web (Vite) server port
MYTEAM_WEB_PORT=5173

# SQLite database path (empty = auto-derived from MYTEAM_ENV)
# When MYTEAM_ENV=runtime, defaults to ~/.myteam/runtime/data.sqlite
# When MYTEAM_ENV=alpha, defaults to ~/.myteam/alpha/data.sqlite
# When MYTEAM_ENV=feature-xxx, defaults to ~/.myteam/feature-xxx/data.sqlite
MYTEAM_DB_PATH=
